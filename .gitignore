# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Python bytecode. The redaction suite regenerates it on import (timestamp-embedding, so it
# differs across clones and Python versions); tracked, it trips the clean-tree release gate.
__pycache__/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs are a deliverable in this repo, not build output. `forge doc` output only.
docs/book/

# Coverage
lcov.info
docs/coverage-report/

# Dotenv file
.env
.env.*
!.env.example

# Key material. Deploys sign from a keystore at a filesystem path (see .env.example); if one is
# ever kept inside the repo it must not become committable.
*.key
*.pem
keystore/
keystore*.json
UTC--*
